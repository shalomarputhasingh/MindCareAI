# Normalise line endings so the repo is identical across Windows, macOS and Linux.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.db binary

# Generated; collapse in diffs and reviews.
package-lock.json linguist-generated=true -diff
