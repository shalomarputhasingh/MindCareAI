# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.turbo

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.key
*.p12
*.pfx

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values, only the template
.env
.env.*
!.env.example

# secrets and credentials
*.local
secrets.json
credentials.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database — contains the user's journal, moods and habits
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# personal data exported from the app
*.mindcare-backup.json
